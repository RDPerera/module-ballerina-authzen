import ballerina/data.jsondata;
import ballerina/http;

const WELL_KNOWN_PATH = "/.well-known/authzen-configuration";
const EVALUATION_PATH = "/access/v1/evaluation";
const EVALUATIONS_PATH = "/access/v1/evaluations";
const SEARCH_SUBJECT_PATH = "/access/v1/search/subject";
const SEARCH_RESOURCE_PATH = "/access/v1/search/resource";
const SEARCH_ACTION_PATH = "/access/v1/search/action";

# An API key the PDP expects in a request header.
public type ApiKeyConfig record {|
    # The API key, sent as the full value of the header. For the `Authorization` header, include the scheme the
    # PDP expects, for example `Basic <key>`
    string apiKey;
    # The name of the header that carries the API key
    string headerName = "Authorization";
|};

# Provides a set of configurations for controlling the behaviours when communicating with a remote HTTP endpoint.
@display {label: "Connection Config"}
public type ConnectionConfig record {|
    # How the client authenticates to the PDP: a Bearer token, OAuth 2.0 (which AuthZEN recommends), HTTP Basic
    # auth, a self-signed JWT or an API key. Leave unset for a PDP that doesn't authenticate its callers. For mutual
    # TLS, set `secureSocket`
    http:ClientAuthConfig|ApiKeyConfig auth?;
    # Reads the PDP metadata when the client is created and sends each request to the endpoint the PDP
    # advertises for it, instead of the default AuthZEN path under the PDP URL. An operation whose endpoint the
    # PDP doesn't advertise then fails without calling the PDP
    boolean discoverEndpoints = false;
    # The HTTP version understood by the client
    http:HttpVersion httpVersion = http:HTTP_2_0;
    # Configurations related to HTTP/1.x protocol
    http:ClientHttp1Settings http1Settings = {};
    # Configurations related to HTTP/2 protocol
    http:ClientHttp2Settings http2Settings = {};
    # The maximum time to wait (in seconds) for a response before closing the connection
    decimal timeout = 30;
    # The choice of setting `forwarded`/`x-forwarded` header
    string forwarded = "disable";
    # Configurations associated with Redirection
    http:FollowRedirects followRedirects?;
    # Configurations associated with request pooling
    http:PoolConfiguration poolConfig?;
    # HTTP caching related configurations
    http:CacheConfig cache = {};
    # Specifies the way of handling compression (`accept-encoding`) header
    http:Compression compression = http:COMPRESSION_AUTO;
    # Configurations associated with the behaviour of the Circuit Breaker
    http:CircuitBreakerConfig circuitBreaker?;
    # Configurations associated with retrying
    http:RetryConfig retryConfig?;
    # Configurations associated with cookies
    http:CookieConfig cookieConfig?;
    # Configurations associated with inbound response size limits
    http:ResponseLimitConfigs responseLimits = {};
    # SSL/TLS-related options, including the client certificate for mutual TLS
    http:ClientSecureSocket secureSocket?;
    # Proxy server related options
    http:ProxyConfig proxy?;
    # Provides settings related to client socket configuration
    http:ClientSocketConfig socketConfig = {};
    # Enables the inbound payload validation functionality which provided by the constraint package. Enabled by default
    boolean validation = true;
    # Enables relaxed data binding on the client side. When enabled, `nil` values are treated as optional,
    # and absent fields are handled as `nilable` types. Enabled by default.
    boolean laxDataBinding = true;
|};

# Headers of an AuthZEN request.
public type RequestHeaders record {|
    # An identifier of the request, generated by the PEP. Sent as the `X-Request-ID` header; the PDP returns it in
    # the response
    @http:Header {name: "X-Request-ID"}
    string requestId?;
|};

# The client of an API: the generated client for a PDP that serves it at its default path, or an HTTP client on
# the endpoint URL the PDP advertises.
type ApiClient GeneratedClient|http:Client;

# Ask a Policy Decision Point (PDP) that implements the OpenID AuthZEN Authorization API 1.0 for access decisions,
# so an integration can act as a Policy Enforcement Point (PEP): evaluate one or many access requests, find the
# subjects, resources or actions an access applies to, and read the PDP metadata.
#
# A denied access is not an error: the operation returns a decision of `false`. Operations return an error only
# when the PDP can't evaluate the request (an HTTP error status) or can't be reached.
@display {label: "AuthZEN"}
public isolated client class Client {
    private final string policyDecisionPoint;
    private final readonly & map<string> apiKeyHeader;
    private final http:Client metadataClient;
    private final ApiClient evaluationClient;
    private final ApiClient? evaluationsClient;
    private final ApiClient? searchSubjectClient;
    private final ApiClient? searchResourceClient;
    private final ApiClient? searchActionClient;

    # Gets invoked to initialize the `connector`.
    #
    # + serviceUrl - The PDP URL, which is its `policy_decision_point` identifier, for example
    #                `https://pdp.example.com` or `https://pdp.example.com/tenant1`. The operations call the default
    #                AuthZEN paths under it, for example `https://pdp.example.com/access/v1/evaluation`
    # + config - The configurations to be used when initializing the `connector`
    # + return - An error if connector initialization failed
    public isolated function init(string serviceUrl, *ConnectionConfig config) returns error? {
        string policyDecisionPoint = check toPolicyDecisionPoint(serviceUrl);
        self.policyDecisionPoint = policyDecisionPoint;

        http:ClientAuthConfig? httpAuth = ();
        map<string> apiKeyHeader = {};
        http:ClientAuthConfig|ApiKeyConfig? auth = config.auth;
        if auth is ApiKeyConfig {
            if auth.headerName.trim() == "" {
                return error("`auth.headerName` must not be empty");
            }
            apiKeyHeader[auth.headerName] = auth.apiKey;
        } else {
            httpAuth = auth;
        }
        self.apiKeyHeader = apiKeyHeader.cloneReadOnly();

        http:ClientConfiguration httpConfig = toHttpConfig(config, httpAuth);
        self.metadataClient = check new (check toMetadataUrl(policyDecisionPoint), httpConfig);
        GeneratedClient defaultClient = check new (httpConfig, policyDecisionPoint);

        if !config.discoverEndpoints {
            self.evaluationClient = defaultClient;
            self.evaluationsClient = defaultClient;
            self.searchSubjectClient = defaultClient;
            self.searchResourceClient = defaultClient;
            self.searchActionClient = defaultClient;
            return;
        }

        Metadata metadata = check fetchMetadata(self.metadataClient, policyDecisionPoint, apiKeyHeader);
        self.evaluationClient = check toApiClient(metadata.accessEvaluationEndpoint, "access_evaluation_endpoint",
                EVALUATION_PATH, policyDecisionPoint, defaultClient, httpConfig);
        self.evaluationsClient = check toOptionalApiClient(metadata.accessEvaluationsEndpoint,
                "access_evaluations_endpoint", EVALUATIONS_PATH, policyDecisionPoint, defaultClient, httpConfig);
        self.searchSubjectClient = check toOptionalApiClient(metadata.searchSubjectEndpoint, "search_subject_endpoint",
                SEARCH_SUBJECT_PATH, policyDecisionPoint, defaultClient, httpConfig);
        self.searchResourceClient = check toOptionalApiClient(metadata.searchResourceEndpoint,
                "search_resource_endpoint", SEARCH_RESOURCE_PATH, policyDecisionPoint, defaultClient, httpConfig);
        self.searchActionClient = check toOptionalApiClient(metadata.searchActionEndpoint, "search_action_endpoint",
                SEARCH_ACTION_PATH, policyDecisionPoint, defaultClient, httpConfig);
    }

    # Get the PDP metadata: its identifier, the endpoints of the APIs it supports and its capabilities. An API
    # whose endpoint is absent is not supported by the PDP.
    #
    # The metadata is read from the well-known URL of the PDP, which inserts `/.well-known/authzen-configuration`
    # between the host and the path of the PDP URL. Fails when the `policy_decision_point` of the metadata isn't
    # the PDP URL of the client, as AuthZEN requires. The request carries the configured credentials, as some PDPs
    # protect their metadata.
    #
    # + return - The PDP metadata
    remote isolated function getMetadata() returns Metadata|error {
        return fetchMetadata(self.metadataClient, self.policyDecisionPoint, self.apiKeyHeader);
    }

    # Evaluate an access request: ask whether the subject may perform the action on the resource, in the given
    # context.
    #
    # + request - The access request
    # + headers - Headers to be sent with the request
    # + return - The access decision. A deny is a decision of `false`, not an error
    remote isolated function evaluate(EvaluationRequest request, RequestHeaders headers = {})
            returns Decision|error {
        ApiClient apiClient = self.evaluationClient;
        EvaluateHeaders httpHeaders = self.toHeaders(headers);
        if apiClient is http:Client {
            return apiClient->post("", jsondata:toJson(request), http:getHeaderMap(httpHeaders));
        }
        GeneratedClient generatedClient = <GeneratedClient>apiClient;
        return generatedClient->evaluate(request, httpHeaders);
    }

    # Evaluate a batch of access requests in one call. The top-level `subject`, `action`, `resource` and `context`
    # of the request are defaults that each entry of `evaluations` may override.
    #
    # + request - The access requests
    # + headers - Headers to be sent with the request
    # + return - The access decisions, in the order of the request entries. With the `deny_on_first_deny` and
    # `permit_on_first_permit` semantics the PDP stops early and returns fewer decisions than entries. A deny is a
    # decision of `false`, not an error
    remote isolated function evaluateBatch(BatchEvaluationRequest request, RequestHeaders headers = {})
            returns BatchEvaluationResponse|error {
        ApiClient apiClient = check supportedClient(self.evaluationsClient, "Access Evaluations",
                "access_evaluations_endpoint");
        EvaluateHeaders httpHeaders = self.toHeaders(headers);
        if apiClient is http:Client {
            return apiClient->post("", jsondata:toJson(request), http:getHeaderMap(httpHeaders));
        }
        GeneratedClient generatedClient = <GeneratedClient>apiClient;
        return generatedClient->evaluateBatch(request, httpHeaders);
    }

    # Find the subjects of a subject type that may perform the action on the resource.
    #
    # + request - The search. Set the subject type to find in `subject`
    # + headers - Headers to be sent with the request
    # + return - The matching subjects. When `page.nextToken` is not empty, more results are available
    remote isolated function searchSubjects(SubjectSearchRequest request, RequestHeaders headers = {})
            returns SubjectSearchResponse|error {
        ApiClient apiClient = check supportedClient(self.searchSubjectClient, "Subject Search",
                "search_subject_endpoint");
        EvaluateHeaders httpHeaders = self.toHeaders(headers);
        if apiClient is http:Client {
            return apiClient->post("", jsondata:toJson(request), http:getHeaderMap(httpHeaders));
        }
        GeneratedClient generatedClient = <GeneratedClient>apiClient;
        return generatedClient->searchSubjects(request, httpHeaders);
    }

    # Find the resources of a resource type on which the subject may perform the action.
    #
    # + request - The search. Set the resource type to find in `resource`
    # + headers - Headers to be sent with the request
    # + return - The matching resources. When `page.nextToken` is not empty, more results are available
    remote isolated function searchResources(ResourceSearchRequest request, RequestHeaders headers = {})
            returns ResourceSearchResponse|error {
        ApiClient apiClient = check supportedClient(self.searchResourceClient, "Resource Search",
                "search_resource_endpoint");
        EvaluateHeaders httpHeaders = self.toHeaders(headers);
        if apiClient is http:Client {
            return apiClient->post("", jsondata:toJson(request), http:getHeaderMap(httpHeaders));
        }
        GeneratedClient generatedClient = <GeneratedClient>apiClient;
        return generatedClient->searchResources(request, httpHeaders);
    }

    # Find the actions the subject may perform on the resource.
    #
    # + request - The search
    # + headers - Headers to be sent with the request
    # + return - The matching actions. When `page.nextToken` is not empty, more results are available
    remote isolated function searchActions(ActionSearchRequest request, RequestHeaders headers = {})
            returns ActionSearchResponse|error {
        ApiClient apiClient = check supportedClient(self.searchActionClient, "Action Search",
                "search_action_endpoint");
        EvaluateHeaders httpHeaders = self.toHeaders(headers);
        if apiClient is http:Client {
            return apiClient->post("", jsondata:toJson(request), http:getHeaderMap(httpHeaders));
        }
        GeneratedClient generatedClient = <GeneratedClient>apiClient;
        return generatedClient->searchActions(request, httpHeaders);
    }

    // The generated header records of the operations are identical, so one value is passed to all of them.
    private isolated function toHeaders(RequestHeaders headers) returns EvaluateHeaders {
        EvaluateHeaders httpHeaders = {...headers};
        foreach [string, string] [name, value] in self.apiKeyHeader.entries() {
            httpHeaders[name] = value;
        }
        return httpHeaders;
    }
}

isolated function toPolicyDecisionPoint(string serviceUrl) returns string|error {
    string url = serviceUrl.trim();
    while url.endsWith("/") {
        url = url.substring(0, url.length() - 1);
    }
    // URL schemes are case-insensitive; the lower-case form is kept so that identifiers compare equal.
    int? schemeEnd = url.indexOf("://");
    string scheme = schemeEnd is int ? url.substring(0, schemeEnd).toLowerAscii() : "";
    if scheme != "https" && scheme != "http" {
        return error(string `The PDP URL must be an http or https URL: '${serviceUrl}'`);
    }
    url = scheme + url.substring(scheme.length());
    if url.includes("?") || url.includes("#") {
        return error(string `The PDP URL must not have a query or a fragment: '${serviceUrl}'`);
    }
    return url;
}

// AuthZEN inserts the well-known segment between the host and the path of the PDP identifier, so the metadata of
// `https://pdp.example.com/tenant1` is at `https://pdp.example.com/.well-known/authzen-configuration/tenant1`.
isolated function toMetadataUrl(string policyDecisionPoint) returns string|error {
    int authorityStart = (check policyDecisionPoint.indexOf("://").ensureType(int)) + 3;
    int? pathStart = policyDecisionPoint.indexOf("/", authorityStart);
    if pathStart is () {
        return policyDecisionPoint + WELL_KNOWN_PATH;
    }
    return policyDecisionPoint.substring(0, pathStart) + WELL_KNOWN_PATH + policyDecisionPoint.substring(pathStart);
}

isolated function fetchMetadata(http:Client metadataClient, string policyDecisionPoint, map<string> headers)
        returns Metadata|error {
    Metadata metadata = check metadataClient->get("", headers);
    string|error advertised = toPolicyDecisionPoint(metadata.policyDecisionPoint);
    if advertised != policyDecisionPoint {
        return error(string `The PDP metadata is for '${metadata.policyDecisionPoint}', not for `
            + string `'${policyDecisionPoint}'. AuthZEN requires the metadata to be discarded`);
    }
    return metadata;
}

isolated function toOptionalApiClient(string? endpoint, string metadataParameter, string defaultPath,
        string policyDecisionPoint, GeneratedClient defaultClient, http:ClientConfiguration httpConfig)
        returns ApiClient?|error {
    if endpoint is () {
        return ();
    }
    return toApiClient(endpoint, metadataParameter, defaultPath, policyDecisionPoint, defaultClient, httpConfig);
}

isolated function toApiClient(string endpoint, string metadataParameter, string defaultPath,
        string policyDecisionPoint, GeneratedClient defaultClient, http:ClientConfiguration httpConfig)
        returns ApiClient|error {
    if endpoint == policyDecisionPoint + defaultPath {
        return defaultClient;
    }
    string scheme = endpoint.toLowerAscii();
    if !scheme.startsWith("https://") && !scheme.startsWith("http://") {
        return error(string `The PDP metadata advertises an invalid '${metadataParameter}': '${endpoint}'`);
    }
    // The client sends its credentials to every endpoint, so an https PDP must not advertise a plain http one.
    if policyDecisionPoint.startsWith("https://") && !scheme.startsWith("https://") {
        return error(string `The PDP metadata advertises '${metadataParameter}' as '${endpoint}', which is not an `
            + "https URL. The client doesn't send requests or credentials to it");
    }
    http:Client endpointClient = check new (endpoint, httpConfig);
    return endpointClient;
}

isolated function supportedClient(ApiClient? apiClient, string api, string metadataParameter)
        returns ApiClient|error {
    if apiClient is () {
        return error(string `The PDP doesn't support the ${api} API: its metadata has no '${metadataParameter}'`);
    }
    return apiClient;
}

isolated function toHttpConfig(ConnectionConfig config, http:ClientAuthConfig? auth) returns http:ClientConfiguration {
    http:ClientConfiguration httpConfig = {
        httpVersion: config.httpVersion,
        http1Settings: config.http1Settings,
        http2Settings: config.http2Settings,
        timeout: config.timeout,
        forwarded: config.forwarded,
        cache: config.cache,
        compression: config.compression,
        responseLimits: config.responseLimits,
        socketConfig: config.socketConfig,
        validation: config.validation,
        laxDataBinding: config.laxDataBinding
    };
    if auth is http:ClientAuthConfig {
        httpConfig.auth = auth;
    }
    http:FollowRedirects? followRedirects = config.followRedirects;
    if followRedirects is http:FollowRedirects {
        httpConfig.followRedirects = followRedirects;
    }
    http:PoolConfiguration? poolConfig = config.poolConfig;
    if poolConfig is http:PoolConfiguration {
        httpConfig.poolConfig = poolConfig;
    }
    http:CircuitBreakerConfig? circuitBreaker = config.circuitBreaker;
    if circuitBreaker is http:CircuitBreakerConfig {
        httpConfig.circuitBreaker = circuitBreaker;
    }
    http:RetryConfig? retryConfig = config.retryConfig;
    if retryConfig is http:RetryConfig {
        httpConfig.retryConfig = retryConfig;
    }
    http:CookieConfig? cookieConfig = config.cookieConfig;
    if cookieConfig is http:CookieConfig {
        httpConfig.cookieConfig = cookieConfig;
    }
    http:ClientSecureSocket? secureSocket = config.secureSocket;
    if secureSocket is http:ClientSecureSocket {
        httpConfig.secureSocket = secureSocket;
    }
    http:ProxyConfig? proxy = config.proxy;
    if proxy is http:ProxyConfig {
        httpConfig.proxy = proxy;
    }
    return httpConfig;
}
